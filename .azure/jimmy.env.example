# Jimmy Azure — operator env (DO NOT COMMIT real secrets)

# Shared Azure OpenAI (same for all 4 users)
AZURE_OPENAI_ENDPOINT=https://medmxlabs-openai.openai.azure.com/openai/v1
AZURE_FOUNDRY_BASE_URL=https://medmxlabs-openai.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_API_KEY=
AZURE_FOUNDRY_API_KEY=

# Dashboard public bind (container)
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
JIMMY_SEED_PROFILES=1
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Four independent logins → profiles jimmy1..jimmy4
JIMMY1_PASSWORD=
JIMMY2_PASSWORD=
JIMMY3_PASSWORD=
JIMMY4_PASSWORD=

# Optional per-user Telegram (set inside each profile .env after seed)
# TELEGRAM_BOT_TOKEN=
